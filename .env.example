# Local development. Production values live in the hosting provider's secret store.
DATABASE_URL="postgresql://plots:plots@localhost:5440/plots?schema=public"


NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Our WhatsApp Business number (sellers chat here to list). Digits with country code.
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER="919999999999"

# WhatsApp Cloud API — leave empty locally: messages go to the dev outbox (console + admin inbox)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_OTP_TEMPLATE_NAME=""

# Protects /api/cron/* (send as Authorization: Bearer <secret>)
CRON_SECRET=""

# Identity verification (KYC). "mock" works only outside production.
KYC_PROVIDER=""

# Header your proxy sets with the real client IP (x-real-ip on Vercel, cf-connecting-ip on Cloudflare). Empty = no IP-based limits.
TRUSTED_IP_HEADER=""

# Optional WhatsApp templates for messages sent outside the 24h window, e.g.
# WHATSAPP_TEMPLATE_AVAILABILITY_CHECK="" WHATSAPP_TEMPLATE_LISTING_LIVE="" WHATSAPP_TEMPLATE_ENQUIRY_RECEIVED=""

# ─── Deployment (Vercel + Supabase) ───
# DATABASE_URL = Supabase *transaction pooler* (port 6543) for the app on Vercel.
# DIRECT_URL   = Supabase *session pooler* (port 5432) — used by `prisma migrate deploy` and the seed.
DIRECT_URL=""
# Vercel Blob token (set automatically when a Blob store is connected). Without it, photos go to local disk.
BLOB_READ_WRITE_TOKEN=""
# Public demo before WhatsApp/KYC are connected: login codes shown on screen, identity check simulated,
# and a "Demo site" banner. NEVER "true" for a real launch.
DEMO_MODE=""
