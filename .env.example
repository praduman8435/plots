# Every setting the app reads. Placeholders only — never commit real values.
# Local development: copy to .env. Production: set them in Vercel → Settings →
# Environment Variables (mark secrets "Sensitive"). The server refuses to start
# in production without DATABASE_URL and SESSION_SECRET (src/lib/env-check.ts).

# ─── Database ───
# Local: docker compose (pnpm db:up). Vercel: Supabase *transaction pooler* (port 6543) for the app.
DATABASE_URL="postgresql://plots:plots@localhost:5440/plots?schema=public"
# Supabase *session pooler* (port 5432) — used by `prisma migrate deploy` (runs on every production deploy).
DIRECT_URL=""

# ─── Site ───
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Our WhatsApp Business number (sellers chat here to list). Digits with country code.
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER="919999999999"
# Shown as the support number. Digits with country code.
NEXT_PUBLIC_SUPPORT_PHONE=""
# "true" once the business number is connected to the WhatsApp Cloud API.
NEXT_PUBLIC_WHATSAPP_CONNECTED=""

# ─── Secrets (generate each with: openssl rand -base64 48) ───
# Signs the in-site chat cookie and encrypts admin two-step secrets. 32+ characters.
# Rotating it signs chat users out and requires admins to set up two-step sign-in again.
SESSION_SECRET=""
# Protects /api/cron/* (sent as Authorization: Bearer <secret>; Vercel Cron does this automatically).
CRON_SECRET=""

# ─── Security ───
# Header your proxy sets with the real client IP: x-real-ip on Vercel, cf-connecting-ip on Cloudflare.
# Empty = per-IP rate limits are off (per-account and global limits still apply). Never a header clients can set.
TRUSTED_IP_HEADER=""
# "true" = every admin must use an authenticator app (two-step sign-in) — recommended in production.
ADMIN_REQUIRE_MFA=""

# ─── WhatsApp Cloud API (Meta) — leave empty locally: messages go to the dev outbox (console + admin inbox) ───
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Verifies X-Hub-Signature-256 on incoming webhooks. Required for the webhook to accept anything in production.
WHATSAPP_APP_SECRET=""
# Any long random string; paste the same value into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_API_VERSION=""
WHATSAPP_OTP_TEMPLATE_NAME=""
WHATSAPP_OTP_TEMPLATE_LANGUAGE=""
# Optional templates for messages sent outside the 24h window.
WHATSAPP_TEMPLATE_AVAILABILITY_CHECK=""
WHATSAPP_TEMPLATE_LANGUAGE=""
# Non-production only: "whatsapp" sends real OTPs from a dev machine.
OTP_PROVIDER=""

# ─── Identity verification (KYC). "mock" works only outside production or with DEMO_MODE. ───
KYC_PROVIDER=""

# ─── Storage ───
# Vercel Blob token (set automatically when a Blob store is connected). Without it, photos go to local disk.
BLOB_READ_WRITE_TOKEN=""
# Local disk folder for photos when Blob isn't configured.
STORAGE_DIR=""

# ─── Before WhatsApp/KYC are connected ───
# "true" shows login codes on screen and simulates identity checks — ANYONE can sign in as ANY seller.
# Never "true" for a real launch.
DEMO_MODE=""

# ─── Optional OTP policy overrides (defaults in src/lib/otp-config.ts) ───
# OTP_EXPIRY_MINUTES=10  OTP_MAX_ATTEMPTS=5  OTP_RESEND_COOLDOWN_SECONDS=45
# OTP_MAX_REQUESTS_PER_WINDOW=5  OTP_REQUEST_WINDOW_MINUTES=60
# OTP_MAX_REQUESTS_PER_IP_PER_HOUR=15  OTP_MAX_REQUESTS_GLOBAL_PER_HOUR=500
# SELLER_SESSION_DURATION_DAYS=30

# ─── Seeding a remote database (pnpm db:seed) ───
# SEED_ADMIN_PASSWORD=""   12+ characters; required for any non-local database.
